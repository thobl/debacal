# Maintainer: thobl (https://github.com/thobl)
pkgname=debacal
pkgver=0.1.3
pkgrel=1
pkgdesc='Local-first desktop calendar with CalDAV sync and flexible event series'
arch=('any')
url='https://github.com/thobl/debacal'
license=('0BSD')
depends=(
  'python>=3.11'
  'pyside6>=6.7' 'pyside6<7'
  'python-icalendar>=6.3' 'python-icalendar<8'
  'python-caldav>=2' 'python-caldav<4'
  'vdirsyncer>=0.21' 'vdirsyncer<0.22'
  'python-dateutil>=2.9' 'python-dateutil<3'
  'python-keyring>=25' 'python-keyring<26'
  'desktop-file-utils'
  'hicolor-icon-theme'
  'ttf-dejavu'
)
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=(
  'gnome-keyring: secure password storage with Secret Service'
  'kwallet: secure password storage in Plasma'
  'python-dbus: KWallet keyring backend support'
)
source=("${pkgname}-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
# Filled from the final release source archive; this recipe is excluded from it.
sha256sums=('e8e29a0146e8275655fa1e8ab0ca1022027134817a10db27c29264a0df43a909')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  python -m build --wheel --no-isolation
}

check() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  desktop-file-validate packaging/linux/debacal.desktop
  local check_root
  check_root=$(mktemp -d "${srcdir}/debacal-check.XXXXXXXX")
  export QT_QPA_PLATFORM=offscreen
  export XDG_DATA_HOME="${check_root}/data"
  export XDG_CONFIG_HOME="${check_root}/config"
  export XDG_CACHE_HOME="${check_root}/cache"
  export XDG_RUNTIME_DIR="${check_root}/runtime"
  install -dm700 "${XDG_RUNTIME_DIR}"
  python -m debacal --help > "${check_root}/help.txt"
  python -c 'import runpy; runpy.run_path("tests/check_discovery_runtime.py", run_name="__main__")'
  python -m debacal --new-instance --demo --screenshot "${check_root}/workspace.png" < /dev/null
  test -s "${check_root}/workspace.png"
  python -c 'from PySide6.QtGui import QImage; import sys; assert not QImage(sys.argv[1]).isNull(), "Invalid workspace screenshot"' "${check_root}/workspace.png"
  if [[ ${DEBACAL_FULL_CHECK:-0} == 1 ]]; then
    # Optional maintainer check: install python-pytest>=9 before enabling this.
    export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
    python -m pytest -q
  fi
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  python -m installer --destdir="${pkgdir}" dist/*.whl
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
